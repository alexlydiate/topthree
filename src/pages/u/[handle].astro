---
import Base from '../../layouts/Base.astro';
import TopThreeCard from '../../components/TopThreeCard.astro';
import HandleForm from '../../components/HandleForm.astro';
import { getProfileByHandle, getTopThreesByUser } from '../../lib/queries';

const { handle } = Astro.params;
const { supabase, profile: viewer } = Astro.locals;

if (!handle) return Astro.redirect('/', 302);

const profile = await getProfileByHandle(supabase, handle);
if (!profile) {
  return new Response('Profile not found', { status: 404 });
}

// Canonicalise casing so /u/Alex and /u/alex don't split link equity.
if (profile.handle !== handle) {
  return Astro.redirect(`/u/${profile.handle}`, 301);
}

const topThrees = await getTopThreesByUser(supabase, profile.id);
const isOwn = viewer?.id === profile.id;
const handleError = Astro.url.searchParams.get('error');
const name = profile.display_name ?? profile.handle;

const description = `${name}'s top threes on TopThree — ${topThrees.length} ${
  topThrees.length === 1 ? 'category' : 'categories'
}.`;
---

<Base title={`@${profile.handle}`} description={description}>
  <header class="profile-head">
    {
      profile.avatar_url ? (
        <img class="avatar" src={profile.avatar_url} alt="" width="64" height="64" />
      ) : (
        <span class="avatar avatar-fallback" aria-hidden="true">
          {name.charAt(0).toUpperCase()}
        </span>
      )
    }

    <div class="identity">
      <h1>{name}</h1>
      <p class="muted handle">@{profile.handle}</p>
      {profile.bio && <p class="bio">{profile.bio}</p>}
    </div>

    {isOwn && <a class="btn" href="/onboarding">Add a TopThree</a>}
  </header>

  {
    /*
     * The handle is a profile address, so this is the one place it means
     * anything -- you are looking at the thing being named. It used to be the
     * first thing a new user saw on the onboarding page, ahead of the reason
     * they came, which put an admin chore in front of the product.
     *
     * handle_confirmed already tracks this, so saving once retires it. Leaving
     * the field unchanged and saving counts as keeping it.
     */
    isOwn && !profile.handle_confirmed && (
      <section class="card handle-nudge">
        <h2>Your profile address</h2>
        <p class="small muted">
          We guessed <strong>@{profile.handle}</strong> from the account you signed
          in with. This page lives at <code>/u/{profile.handle}</code> &mdash; change
          it now if you&rsquo;d rather, or save to keep it.
        </p>

        {handleError && <p class="notice" role="alert">{handleError}</p>}

        <HandleForm profile={profile} />
      </section>
    )
  }

  {
    isOwn && profile.handle_confirmed && (
      <details class="edit-profile">
        <summary>Edit profile</summary>
        {handleError && <p class="notice" role="alert">{handleError}</p>}
        <HandleForm profile={profile} />
      </details>
    )
  }

  <section>
    <h2>
      {topThrees.length} TopThree{topThrees.length === 1 ? '' : 's'}
    </h2>

    {
      topThrees.length === 0 ? (
        <p class="muted">
          {isOwn ? (
            <>Nothing yet. <a href="/onboarding">Post your first.</a></>
          ) : (
            <>@{profile.handle} hasn&rsquo;t posted a TopThree yet.</>
          )}
        </p>
      ) : (
        <div class="list-grid">
          {topThrees.map((tt) => (
            <TopThreeCard
              entries={tt.entries}
              note={tt.note}
              categoryName={tt.category.name}
              categorySlug={tt.category.slug}
              updatedAt={tt.updated_at}
              editHref={isOwn ? `/c/${tt.category.slug}/add` : undefined}
            />
          ))}
        </div>
      )
    }
  </section>
</Base>

<style>
  .profile-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface-alt);
    flex: none;
  }
  .avatar-fallback {
    display: inline-grid;
    place-items: center;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--muted);
    border: 1px solid var(--border);
  }

  .identity { flex: 1; min-width: 0; }
  .identity h1 { margin: 0; }
  .handle { margin: 0; }
  .bio { margin: 0.5rem 0 0; }

  .handle-nudge {
    margin-bottom: 2rem;
    border-left: 3px solid var(--accent);
  }
  .handle-nudge h2 { font-size: 1.05rem; }


  .edit-profile {
    margin-bottom: 2rem;
    font-size: 0.9rem;
  }
  .edit-profile summary {
    cursor: pointer;
    color: var(--muted);
    width: fit-content;
  }
  .edit-profile summary:hover { color: var(--text); }

  code {
    background: var(--surface-alt);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }

  .list-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    margin-top: 1rem;
  }
</style>
