---
import Base from '../layouts/Base.astro';
import CategoryPicker from '../components/CategoryPicker.astro';
import NewCategoryForm from '../components/NewCategoryForm.astro';
import { listCategories, getTopThreesByUser } from '../lib/queries';

const { supabase, userId, profile } = Astro.locals;

if (!userId || !profile) {
  // Preserve the query string, or a signed-out visitor who clicked "Start one."
  // loses the category name across the login round trip.
  return Astro.redirect(
    '/login?next=' + encodeURIComponent(Astro.url.pathname + Astro.url.search),
    302,
  );
}

const search = Astro.url.searchParams.get('q') ?? '';
const error = Astro.url.searchParams.get('error');

// Arriving from a search that found nothing ("Start one."), so the name is
// already known -- don't make them type it a second time.
const suggestedName = Astro.url.searchParams.get('name') ?? '';

const [categories, mine] = await Promise.all([
  listCategories(supabase, { search, limit: 24 }),
  getTopThreesByUser(supabase, userId),
]);

const isFirstTime = mine.length === 0;
const postedIn = new Set(mine.map((t) => t.category.id));

// Same courtesy for a fruitless search made on this page.
const prefillName = suggestedName || (search && categories.length === 0 ? search : '');

/**
 * Someone arriving with nothing posted has no idea what this site wants from
 * them, and a blank text box is a worse first ask than a list of things to
 * click. So lead with the categories and offer creation underneath.
 *
 * Unless they got here from "Start one.", which is an explicit statement of
 * intent to create -- in that case the prefilled form goes first, or they land
 * below the thing they asked for.
 */
const createFirst = !isFirstTime || Boolean(prefillName);
---

<Base
  title={isFirstTime ? 'Your first TopThree' : 'Add a TopThree'}
  description="Pick a category and post your top three."
  indexable={false}
>
  <div class="wrap stack">
    {error && <p class="notice" role="alert">{error}</p>}

    <section>
      <h1>{isFirstTime ? 'What are your top three?' : 'Post another TopThree'}</h1>
      <p class="muted">
        {
          isFirstTime
            ? 'Pick a category that interests you, or start one of your own.'
            : 'Start a category of your own, or pick an existing one.'
        }
      </p>
    </section>

    {
      createFirst ? (
        <>
          <NewCategoryForm heading="Start a new category" prefillName={prefillName} />
          <CategoryPicker
            heading="Or pick an existing one"
            categories={categories}
            search={search}
            postedIn={postedIn}
            createPosition="above"
          />
        </>
      ) : (
        <>
          <CategoryPicker
            heading="Pick a category"
            categories={categories}
            search={search}
            postedIn={postedIn}
            createPosition="below"
            limit={8}
          />
          <NewCategoryForm heading="None of these? Start your own" />
        </>
      )
    }
  </div>
</Base>

<style>
  .wrap { max-width: 42rem; margin: 0 auto; }
  .wrap > * + * { margin-top: 2rem; }
</style>
