---
import Base from '../layouts/Base.astro';
import { isLocalSupabase, TEST_USERS, TEST_PASSWORD } from '../lib/devAuth';
import { safeNext } from '../lib/redirects';

// In production this must look like a route that does not exist.
if (!isLocalSupabase()) {
  return new Response('Not found', { status: 404 });
}

const next = safeNext(Astro.url.searchParams.get('next'), '/');
const error = Astro.url.searchParams.get('error');
---

<Base title="Dev sign-in" description="Local development sign-in." indexable={false}>
  <div class="wrap">
    <p class="warn">
      <strong>Local development only.</strong> This page is served only while the
      app is pointed at a Supabase on this machine. Against a hosted project it
      returns 404.
    </p>

    <h1>Sign in as a test user</h1>
    <p class="muted">
      TopThree is social-SSO-only, so without this you would need to register a
      real OAuth app before you could log in locally at all.
    </p>

    {error && <p class="notice" role="alert">{error}</p>}

    <ul class="users">
      {
        TEST_USERS.map((user) => (
          <li>
            <form method="post" action="/api/dev-login">
              <input type="hidden" name="email" value={user.email} />
              <input type="hidden" name="password" value={TEST_PASSWORD} />
              <input type="hidden" name="next" value={next} />
              <button type="submit" class="user-btn">
                <span class="avatar" aria-hidden="true">{user.name.charAt(0)}</span>
                <span class="who">
                  <strong>{user.name}</strong>
                  <span class="muted small">@{user.handle} &middot; {user.email}</span>
                </span>
              </button>
            </form>
          </li>
        ))
      }
    </ul>

    <details>
      <summary class="small muted">Sign in as someone else</summary>
      <form method="post" action="/api/dev-login" class="manual">
        <input type="hidden" name="next" value={next} />
        <label class="visually-hidden" for="email">Email</label>
        <input id="email" name="email" type="text" placeholder="email" required />
        <label class="visually-hidden" for="password">Password</label>
        <input id="password" name="password" type="text" placeholder={`password (default: ${TEST_PASSWORD})`} />
        <button type="submit" class="btn">Sign in</button>
      </form>
    </details>

    <p class="small muted footnote">
      Users missing? Run <code>npm run seed</code>.
    </p>
  </div>
</Base>

<style>
  .wrap { max-width: 30rem; margin: 1rem auto; }

  .warn {
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
  }

  .users {
    list-style: none;
    margin: 1.5rem 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .user-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .user-btn:hover { border-color: var(--accent); background: var(--surface-alt); }

  .avatar {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    font-weight: 700;
    color: var(--muted);
  }

  .who { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }

  .manual {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .manual .btn { justify-self: start; }

  .footnote { margin-top: 1.5rem; }
  code {
    background: var(--surface-alt);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }
</style>
